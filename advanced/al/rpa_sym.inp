&GLOBAL
  PROJECT adv_rpa_al_sym
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-5
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 200
      SCF_GUESS ATOMIC
      ADDED_MOS 10000000
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
    &END SCF
    &XC
      &WF_CORRELATION
        MEMORY 2000
        NUMBER_PROC 1
        &INTEGRALS
          SIZE_LATTICE_SUM 3
          &WFC_GPW
            CUTOFF 200
            REL_CUTOFF 20
          &END WFC_GPW
        &END INTEGRALS
        &LOW_SCALING
          DO_EXTRAPOLATE_KPOINTS FALSE
          DO_KPOINTS
          MEMORY_CUT 1
        &END LOW_SCALING
        &RI_RPA
          RPA_NUM_QUAD_POINTS 6
        &END RI_RPA
      &END WF_CORRELATION
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8559542459167657 2.855954291634759 2.855955
      ALPHA_BETA_GAMMA 60.0000033779252 60.00000284838631 60.000002428463056
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Al 0 0 0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
      BASIS_SET RI_HFX RI_45_4_4_3_2_0_0_0_1.7e-06
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
