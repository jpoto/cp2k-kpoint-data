&GLOBAL
  PROJECT adv_wannier_al_sym
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-5
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      SYMMETRY ON
      EPS_SYMMETRY 1.0E-8
      VERBOSE T
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 200
      SCF_GUESS ATOMIC
      ADDED_MOS -1
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
      &WANNIER90 ON
        KPOINTS_SOURCE SCF
        SEED_NAME adv_wannier_al
        WANNIER_FUNCTIONS 4
      &END WANNIER90
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8559542459167657 2.855954291634759 2.855955
      ALPHA_BETA_GAMMA 60.0000033779252 60.00000284838631 60.000002428463056
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Al 0 0 0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
