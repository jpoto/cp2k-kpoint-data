&GLOBAL
  PROJECT adv_hfx_alas_nosym
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    AUTO_BASIS RI_HFX SMALL
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-5
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      SYMMETRY OFF
      FULL_GRID ON
      VERBOSE T
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 100
      SCF_GUESS ATOMIC
      ADDED_MOS -1
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE IDENTITY
        &END INTERACTION_POTENTIAL
        &RI
          EPS_FILTER 1.0E-10
          MEMORY_CUT 2
          RI_METRIC IDENTITY
        &END RI
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.013398250535005 4.013397970922498 4.01339746
      ALPHA_BETA_GAMMA 59.9999959688638 59.99999827352137 59.9999965443567
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Al 0 0 0
      As 0.25 0.25 0.25
    &END COORD
    &KIND Al
      BASIS_SET ccGRB-D-q3
      POTENTIAL GTH-PBE0-q3
    &END KIND
    &KIND As
      BASIS_SET ccGRB-D-q5
      POTENTIAL GTH-PBE0-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
