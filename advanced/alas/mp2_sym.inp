&GLOBAL
  PROJECT adv_mp2_alas_sym
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-5
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 200
      SCF_GUESS ATOMIC
      ADDED_MOS 10000000
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE IDENTITY
        &END INTERACTION_POTENTIAL
        &RI
          MEMORY_CUT 2
          RI_METRIC IDENTITY
        &END RI
        &SCREENING
          EPS_SCHWARZ 1.0E-8
          SCREEN_ON_INITIAL_P FALSE
        &END SCREENING
      &END HF
      &WF_CORRELATION
        MEMORY 2000
        NUMBER_PROC 1
        &INTEGRALS
          ERI_METHOD GPW
          &WFC_GPW
            CUTOFF 200
            REL_CUTOFF 20
            EPS_FILTER 1.0E-6
            EPS_GRID 1.0E-6
          &END WFC_GPW
        &END INTEGRALS
        &RI_SOS_MP2
          QUADRATURE_POINTS 5
        &END RI_SOS_MP2
      &END WF_CORRELATION
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.013398250535005 4.013397970922498 4.01339746
      ALPHA_BETA_GAMMA 59.9999959688638 59.99999827352137 59.9999965443567
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Al 0 0 0
      As 0.25 0.25 0.25
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
      BASIS_SET RI_HFX RI_45_4_4_3_2_0_0_0_1.7e-06
    &END KIND
    &KIND As
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
      BASIS_SET RI_HFX RI_46_5_4_3_2_0_0_0_8.1e-06
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
