&GLOBAL
  PROJECT adv_wannier_alas_sym
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-5
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      SYMMETRY ON
      EPS_SYMMETRY 1.0E-8
      VERBOSE T
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 200
      SCF_GUESS ATOMIC
      ADDED_MOS -1
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
      &WANNIER90 ON
        KPOINTS_SOURCE SCF
        SEED_NAME adv_wannier_alas
        WANNIER_FUNCTIONS 4
      &END WANNIER90
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.013398250535005 4.013397970922498 4.01339746
      ALPHA_BETA_GAMMA 59.9999959688638 59.99999827352137 59.9999965443567
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Al 0 0 0
      As 0.25 0.25 0.25
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND As
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
