      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MACDONALD 4 4 4 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE 0
      SYMMETRY F
      FULL_GRID F
      LATTICE_FFT OFF
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ABC  4.6899679324  7.3328876859  7.4942121091
      ALPHA_BETA_GAMMA  80.380302  73.912092  80.524379
