        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MACDONALD 4 4 4 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE 0
      SYMMETRY F
      FULL_GRID T
      LATTICE_FFT OFF
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ABC  5.6952029691  5.6952029691  4.8994552444
      ALPHA_BETA_GAMMA  64.691800  64.691800  34.475402
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED .TRUE.
