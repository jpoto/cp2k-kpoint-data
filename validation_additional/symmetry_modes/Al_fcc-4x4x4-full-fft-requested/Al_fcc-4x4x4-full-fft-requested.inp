! CP2K symmetry-reduction comparison — generated by run_symmetry_modes.py
! Structure:   FCC Al,   cubic  Fm-3m     #225
! Mode:        Full, FFT requested
! Mesh:        4x4x4-shifted
!
&GLOBAL
  PROJECT Al_fcc
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MACDONALD 4 4 4 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE 0
      SYMMETRY F
      FULL_GRID T
      LATTICE_FFT ON
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ABC  2.8559542459  2.8559542916  2.8559550000
      ALPHA_BETA_GAMMA  60.000003  60.000003  60.000002
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED .TRUE.
      Al  0.0000000000  0.0000000000  0.0000000000
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
