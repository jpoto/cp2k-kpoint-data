&GLOBAL
  PROJECT AlAs_zb
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &PRINT
      &KPOINTS ON
        FILENAME __STD_OUT__
      &END KPOINTS
    &END PRINT
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE 0
      SYMMETRY F
      FULL_GRID F
      LATTICE_FFT OFF
      GAMMA_CENTERED .TRUE.
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ABC  4.0133978007  4.0133978007  4.0133978007
      ALPHA_BETA_GAMMA  60.000000  60.000000  60.000000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED .TRUE.
      Al  0.0000000000  0.0000000000  0.0000000000
      As  0.2500000000  0.2500000000  0.2500000000
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND As
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
