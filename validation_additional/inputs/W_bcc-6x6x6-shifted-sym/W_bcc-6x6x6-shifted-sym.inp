! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   BCC W,    cubic  Im-3m     #229
! Source:      regtest_inputs (Materials Project)
! Mesh:        6x6x6-shifted
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT W_bcc
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  2.7455737218  2.7455738070  2.7455745900
      ALPHA_BETA_GAMMA  109.471241  109.471242  109.471199
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      W  0.0000000000  0.0000000000  0.0000000000
    &END COORD

    &KIND W
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
