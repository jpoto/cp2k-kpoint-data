! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   ZnO,      hexag  P6_3mc    #186
! Source:      regtest_inputs (Materials Project)
! Mesh:        6x6x6-gamma
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT ZnO_wurt
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
      GAMMA_CENTERED .TRUE.
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  3.2373511800  3.2373508669  5.2220613000
      ALPHA_BETA_GAMMA  90.000000  90.000000  119.999993
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Zn  0.6666670000  0.3333330000  0.5005917000
      Zn  0.3333330000  0.6666670000  0.0005917000
      O  0.6666670000  0.3333330000  0.8797183000
      O  0.3333330000  0.6666670000  0.3797183000
    &END COORD

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Zn
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
