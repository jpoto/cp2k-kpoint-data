&GLOBAL
  PROJECT BaFe2As2
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS MOPAC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
        NBUFFER 15
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 4 4 4 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
      GAMMA_CENTERED .TRUE.
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  3.9365898863  3.9365898863  6.9098000100
      ALPHA_BETA_GAMMA  106.550215  106.550215  90.000000
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Ba  0.0000000000  0.0000000000  0.0000000000
      Fe_a  0.2500000000  0.7500000000  0.5000000000
      Fe_b  0.7500000000  0.2500000000  0.5000000000
      As  0.3434895800  0.3434895800  0.6869801500
      As  0.6565104200  0.6565104200  0.3130198500
    &END COORD

    &KIND As
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND Ba
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q10
    &END KIND
    &KIND Fe_a
      ELEMENT Fe
      MAGNETIZATION 2
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q16
    &END KIND
    &KIND Fe_b
      ELEMENT Fe
      MAGNETIZATION -2
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q16
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
