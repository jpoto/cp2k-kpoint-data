! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   CoF2,     tetrag P4_2/mnm  #136
! Source:      regtest_inputs (Materials Project)
! Mesh:        6x6x6-shifted
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT CoF2_rutile
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS MOPAC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
        NBUFFER 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  3.1991646900  4.6435194100  4.6435194100
      ALPHA_BETA_GAMMA  90.000025  90.000000  90.000000
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Co_a  0.0000000000  0.0000000000  0.0000000000
      Co_b  0.5000000000  0.5000000000  0.5000000000
      F  0.0000000000  0.3043367400  0.3043367400
      F  0.0000000000  0.6956632600  0.6956632600
      F  0.5000000000  0.1956632600  0.8043367400
      F  0.5000000000  0.8043367400  0.1956632600
    &END COORD

    &KIND Co_a
      ELEMENT Co
      MAGNETIZATION 3
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q17
    &END KIND
    &KIND Co_b
      ELEMENT Co
      MAGNETIZATION -3
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q17
    &END KIND
    &KIND F
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q7
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
