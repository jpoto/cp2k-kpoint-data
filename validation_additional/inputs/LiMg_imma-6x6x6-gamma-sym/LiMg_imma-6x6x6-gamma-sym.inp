! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   LiMg,     ortho  Imma      #74
! Source:      regtest_inputs (Materials Project)
! Mesh:        6x6x6-gamma
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT LiMg_imma
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
      GAMMA_CENTERED .TRUE.
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  5.6952029691  5.6952029691  4.8994552444
      ALPHA_BETA_GAMMA  64.691800  64.691800  34.475402
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Li  0.6332994800  0.6332994800  0.6164588100
      Li  0.3667005200  0.3667005200  0.3835411900
      Mg  0.8846043800  0.8846043800  0.8645454700
      Mg  0.1153956200  0.1153956200  0.1354545300
    &END COORD

    &KIND Li
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND Mg
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q10
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
