&GLOBAL
  PROJECT BaAg_pnma
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.15
        NBUFFER 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  4.9917831100  6.6711655900  8.7572832600
      ALPHA_BETA_GAMMA  90.000000  90.000000  90.000000
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Ba  0.2500000000  0.1301124700  0.1811354600
      Ba  0.7500000000  0.8698875300  0.8188645400
      Ba  0.7500000000  0.6301124700  0.3188645400
      Ba  0.2500000000  0.3698875300  0.6811354600
      Ag  0.2500000000  0.6118394000  0.0331815000
      Ag  0.7500000000  0.3881606000  0.9668185000
      Ag  0.7500000000  0.1118394000  0.4668185000
      Ag  0.2500000000  0.8881606000  0.5331815000
    &END COORD

    &KIND Ag
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q11
    &END KIND
    &KIND Ba
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q10
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
