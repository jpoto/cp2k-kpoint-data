! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   Cd,       hexag  P6_3/mmc  #194
! Source:      regtest_inputs (Materials Project)
! Mesh:        6x6x6-shifted
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT Cd_hcp
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  2.9584744100  2.9584752305  5.8859279300
      ALPHA_BETA_GAMMA  90.000000  90.000000  120.000012
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Cd  0.3333330000  0.6666670000  0.2500000000
      Cd  0.6666670000  0.3333330000  0.7500000000
    &END COORD

    &KIND Cd
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
