&GLOBAL
  PROJECT Bi_rhomb
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 6 6 6 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  4.8680298447  4.8680298447  4.8680298447
      ALPHA_BETA_GAMMA  55.563294  55.563294  55.563294
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Bi  0.2320020200  0.2320020200  0.2320020200
      Bi  0.7679979800  0.7679979800  0.7679979800
    &END COORD

    &KIND Bi
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
