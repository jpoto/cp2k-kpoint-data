! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   FCC Al,   cubic  Fm-3m     #225
! Source:      regtest_inputs (Materials Project)
! Mesh:        4x4x4-gamma
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT Al_fcc
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 4 4 4 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
      GAMMA_CENTERED .TRUE.
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  2.8559542459  2.8559542916  2.8559550000
      ALPHA_BETA_GAMMA  60.000003  60.000003  60.000002
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Al  0.0000000000  0.0000000000  0.0000000000
    &END COORD

    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
