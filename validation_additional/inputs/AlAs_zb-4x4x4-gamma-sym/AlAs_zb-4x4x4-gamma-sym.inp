! CP2K k-point IBZ regression — generated by run_additional.py
! Structure:   AlAs,     cubic  F-43m     #216
! Source:      regtest_inputs (Materials Project)
! Mesh:        4x4x4-gamma
! Symmetry reduction: ON
!
&GLOBAL
  PROJECT AlAs_zb
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    LSD .TRUE.
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-09
      MAX_SCF 200
      ADDED_MOS 10
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &KPOINTS
      SCHEME MACDONALD 4 4 4 0.5 0.5 0.5
      WAVEFUNCTIONS COMPLEX
      SYMMETRY .TRUE.
      EPS_SYMMETRY 1.0E-05
      GAMMA_CENTERED .TRUE.
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      ABC  4.0133978007  4.0133978007  4.0133978007
      ALPHA_BETA_GAMMA  60.000000  60.000000  60.000000
      PERIODIC XYZ
    &END CELL

    &COORD
      SCALED .TRUE.
      Al  0.0000000000  0.0000000000  0.0000000000
      As  0.2500000000  0.2500000000  0.2500000000
    &END COORD

    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND As
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
